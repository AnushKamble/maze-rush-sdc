# ==============================
# SERVER (packages/server/.env)
# ==============================
PORT=4000
NODE_ENV=development
# Comma-separated list of origins allowed to connect (big-screen + phone-client URLs)
# In production, set this to your deployed frontend URLs, e.g.:
# CORS_ORIGINS=https://tmr-bigscreen.vercel.app,https://tmr-phone.vercel.app
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Optional: persistence (leave blank to use in-memory / SQLite file fallback)
DATABASE_URL=
# Shared secret typed into the admin panel at the event — keep this private,
# don't commit your real value. Change it before deploying.
ADMIN_TOKEN=sdc-orientation-2026

# ==============================
# BIG-SCREEN CLIENT (packages/big-screen/.env)
# ==============================
# Point this at your deployed server (Render/Railway URL) in production.
VITE_SERVER_URL=http://localhost:4000

# ==============================
# PHONE CLIENT (packages/phone-client/.env)
# ==============================
VITE_SERVER_URL=http://localhost:4000
